<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>dotnet-nuget-map</ToolCommandName>
    <PackageId>NugetDependencyMapper</PackageId>
    <Version>0.5.0</Version>
    <Description>Explore NuGet dependencies, version drift and upgrade impact in a standalone interactive HTML report.</Description>
    <Authors>NugetDependencyMapper contributors</Authors>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/thedigitaljedi86/NugetDependencyMapper</RepositoryUrl>
    <PackageProjectUrl>https://github.com/thedigitaljedi86/NugetDependencyMapper</PackageProjectUrl>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="Report/*" />
    <EmbeddedResource Include="Report/Fonts/*" />
    <None Include="Report/Fonts/OpenSans.OFL.txt" Pack="true" PackagePath="licenses/" />
    <None Include="../../README.md" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>
